---
// Decorative inline icons (stroke = currentColor). Always aria-hidden: the accessible name lives on the link or button.
type Name = "phone" | "arrow-down" | "arrow-right" | "menu" | "close" | "instagram" | "facebook" | "pin" | "clock";
interface Props { name: Name; size?: number; class?: string; }
const { name, size = 20, class: cls } = Astro.props;
---
<svg class:list={["icon", cls]} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === "phone" && <path d="M5 4h3.2l1.6 4-2 1.3a10.5 10.5 0 0 0 6.9 6.9l1.3-2 4 1.6V19a1.6 1.6 0 0 1-1.7 1.6A16.3 16.3 0 0 1 3.4 5.7 1.6 1.6 0 0 1 5 4Z" />}
  {name === "arrow-down" && <path d="M12 4v16m0 0-6-6m6 6 6-6" />}
  {name === "arrow-right" && <path d="M4 12h16m0 0-6-6m6 6-6 6" />}
  {name === "menu" && <path d="M4 7h16M4 12h16M4 17h16" />}
  {name === "close" && <path d="M6 6l12 12M18 6 6 18" />}
  {name === "instagram" && (
    <>
      <rect x="3.5" y="3.5" width="17" height="17" rx="4.5" />
      <circle cx="12" cy="12" r="4" />
      <path d="M17 7h.01" />
    </>
  )}
  {name === "facebook" && <path d="M14 21v-7.5h2.6l.4-3H14V8.7c0-.9.3-1.5 1.5-1.5H17V4.6a20 20 0 0 0-2.3-.1C12.4 4.5 11 5.9 11 8.4v2.1H8.5v3H11V21" />}
  {name === "clock" && (
    <>
      <circle cx="12" cy="12" r="8.5" />
      <path d="M12 7.5V12l3 2" />
    </>
  )}
  {name === "pin" && (
    <>
      <path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11Z" />
      <circle cx="12" cy="10" r="2.3" />
    </>
  )}
</svg>
